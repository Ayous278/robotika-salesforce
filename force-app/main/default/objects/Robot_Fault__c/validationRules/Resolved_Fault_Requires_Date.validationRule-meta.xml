<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolved_Fault_Requires_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Fault_Status__c, &quot;Resolved&quot;),
    ISBLANK(Resolved_At__c)
)</errorConditionFormula>
    <errorDisplayField>Resolved_At__c</errorDisplayField>
    <errorMessage>Resolved At is required when the Fault Status is Resolved.</errorMessage>
</ValidationRule>
