<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Battery_Level_Range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Battery_Level__c)),
    OR(
        Battery_Level__c &lt; 0,
        Battery_Level__c &gt; 1
    )
)</errorConditionFormula>
    <errorDisplayField>Battery_Level__c</errorDisplayField>
    <errorMessage>Battery Level must be between 0% and 100%.</errorMessage>
</ValidationRule>
