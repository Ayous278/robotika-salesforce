<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Work_Order_Requires_End</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Work_Order_Status__c, &quot;Completed&quot;),
    ISBLANK(Actual_End__c)
)</errorConditionFormula>
    <errorDisplayField>Actual_End__c</errorDisplayField>
    <errorMessage>Actual End is required when the work order is completed.</errorMessage>
</ValidationRule>
