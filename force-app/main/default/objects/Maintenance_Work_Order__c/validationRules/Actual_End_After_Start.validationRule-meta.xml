<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Actual_End_After_Start</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Actual_Start__c)),
    NOT(ISBLANK(Actual_End__c)),
    Actual_End__c &lt; Actual_Start__c
)</errorConditionFormula>
    <errorDisplayField>Actual_End__c</errorDisplayField>
    <errorMessage>Actual End cannot be earlier than Actual Start.</errorMessage>
</ValidationRule>
