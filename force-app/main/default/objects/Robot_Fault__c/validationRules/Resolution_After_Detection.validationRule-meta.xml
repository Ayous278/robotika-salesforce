<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolution_After_Detection</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Detected_At__c)),
    NOT(ISBLANK(Resolved_At__c)),
    Resolved_At__c &lt; Detected_At__c
)</errorConditionFormula>
    <errorDisplayField>Resolved_At__c</errorDisplayField>
    <errorMessage>Resolved At cannot be earlier than Detected At.</errorMessage>
</ValidationRule>
